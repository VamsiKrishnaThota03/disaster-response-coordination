# Backend base URL (defaults to http://localhost:3001 in dev, the Render URL in production builds)
VITE_BACKEND_URL=http://localhost:3001
# Supabase Auth for sign-in (Settings -> API). The anon key is public by design.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
