# Supabase project (Settings -> API)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>

# Optional AI / geocoding (fallbacks are used when unset)
GEMINI_API_KEY=<gemini-api-key>
# GEMINI_MODEL=gemini-2.5-flash
OPENCAGE_API_KEY=<opencage-api-key>

# Comma-separated browser origins allowed by CORS and Socket.IO
CORS_ORIGINS=http://localhost:5173
# Comma-separated Supabase Auth user IDs that may edit/delete anything
# ADMIN_USER_IDS=<uuid>,<uuid>

# Local development only: treat every request as a signed-in admin
# AUTH_DISABLED=true

PORT=3001
# HOST=127.0.0.1
# RATE_LIMIT_PER_SECOND=10
# LOG_TO_FILE=false
