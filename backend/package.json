{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for Disaster Response Coordination Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:api": "bash test-api.sh"
  },
  "keywords": [
    "disaster",
    "response",
    "coordination",
    "express",
    "socket.io",
    "supabase",
    "postgis",
    "gemini"
  ],
  "author": "Vamsi Krishna Thota",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "rate-limiter-flexible": "^11.4.0",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.3.2"
  },
  "type": "module",
  "jest": {
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/src/tests/setupEnv.js"
    ],
    "testMatch": [
      "**/src/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
